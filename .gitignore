# Unity Asset Store packages
*.unitypackage

# Ignore everything in Assets except Scripts
/Assets/*
!/Assets/Scripts/
!/Assets/Scenes/
!/Assets/Prefabs/
!/Assets/Resources/
!/Assets/ROLLER/

# Keep .meta files for tracked folders
!/Assets/*.meta
!/Assets/Scripts/*.meta

# Ignore specific asset types
*.prefab
*.unity
*.mat
*.asset

